# Copie para .env e ajuste somente se necessário. Não publique credenciais.
# O link fornecido usa IQ4_XS. Não renomeie um IQ4_XS para Q4_K_M.
DIDA_MODEL_PATH=.models/Qwen3.8-27B-Uncensored-IQ4_XS.gguf
DIDA_LLM_BASE_URL=http://127.0.0.1:8081/v1
DIDA_CONTEXT_SIZE=8192
DIDA_MODEL_THREADS=4
DIDA_GPU_LAYERS=0
DIDA_OWNER_NAME=Rubens
# Opcional: diretório de um modelo faster-whisper já baixado, para transcrição local.
DIDA_STT_MODEL_PATH=
# Opcional: somente pesquisa web. Não é necessário para conversar com o Qwen.
TAVILY_API_KEY=
