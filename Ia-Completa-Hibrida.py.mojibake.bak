# ================= MEMÃ“RIA PERSISTENTE =================
class Memory:
    def __init__(self, path: Path):
        self.path=path
        self.data={"conversas":[]}
        self.lock=threading.Lock()
        self.session_start=time.time()
        self.load()
    
    def load(self):
        try:
            if self.path.exists():
                self.data=json.loads(self.path.read_text())
        except: self.data={"conversas":[]}

    @staticmethod
    def _is_noise(c: dict) -> bool:
        user=str(c.get("user", "")).strip().lower()
        bot=str(c.get("bot", "")).strip().lower()
        # NÃ£o reintroduz documentaÃ§Ã£o colada por engano nem respostas de erro antigas.
        return user.startswith("# dida v4") or bot in {"desculpa, sem resposta agora.", "desculpa, sem resposta agora"} or bot.startswith("desculpa, nÃ£o consegui gerar uma resposta")
    
    def save(self):
        try:
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            self.path.write_text(json.dumps(self.data, ensure_ascii=False, indent=2))
        except Exception as e:
            print(f"[memory] save {e}")
    
    def add(self, user: str, bot: str, meta: dict=None):
        if self._is_noise({"user":user,"bot":bot}):
            return
        with self.lock:
            self.data["conversas"].append({
                "ts": time.time(),
                "user": user[:2000],
                "bot": bot[:2000],
                "meta": meta or {}
            })
            # mantÃ©m sÃ³ Ãºltimas 200
            if len(self.data["conversas"]) > 200:
                self.data["conversas"] = self.data["conversas"][-200:]
            self.save()
    
    def search(self, query: str, n=3) -> str:
        """Busca simples por similaridade de palavras"""
        if not self.data["conversas"]: return ""
        stop=set("a ao aos as de da das do dos e Ã© em na nas no nos o os para por que um uma uns umas eu vocÃª voce me minha meu com como isso isto aÃ­ ai jÃ¡ ja se sua seu suas seus tÃ¡ ta te foi ser nÃ£o nao sim ou mas mais muito muito pode vai vou fala falar aqui ela ele eles elas ela esse essa este esta estou era oi oie olÃ¡ ola dida diga dizer sabe quem sou tchau obrigado obrigada".split())
        q_words={w for w in re.findall(r"[\wÃ€-Ã¿]+",query.lower()) if len(w)>=3 and w not in stop}
        # SaudaÃ§Ãµes e frases curtas nÃ£o devem puxar respostas antigas para o
        # prompt, pois isso causa repetiÃ§Ã£o de diÃ¡logos anteriores.
        if len(q_words)<2: return ""
        scored=[]
        for c in self.data["conversas"][-50:]:
            if c.get("ts",0)>=self.session_start: continue
            if self._is_noise(c): continue
            text=(c["user"]+" "+c["bot"]).lower()
            text_words=set(re.findall(r"[\wÃ€-Ã¿]+",text))
            score=len(q_words & text_words)
            if score>=2:
                scored.append((score, c))
        scored.sort(key=lambda x: x[0], reverse=True)
        if not scored: return ""
        ctx=[]
        for _, c in scored[:n]:
            ctx.append(f"UsuÃ¡rio disse: {c['user']}\nVocÃª respondeu: {c['bot']}")
        return "\n---\n".join(ctx)

    def recent_messages(self, n=4) -> list:
        """MantÃ©m a sequÃªncia da conversa atual sem reintroduzir diÃ¡logos antigos."""
        with self.lock:
            recent=[c for c in self.data["conversas"]
                    if c.get("ts",0)>=self.session_start and not self._is_noise(c)]
        messages=[]
        for c in recent[-n:]:
            messages.append({"role":"user","content":c["user"][:600]})
            messages.append({"role":"assistant","content":c["bot"][:1000]})
        return messages

memory = Memory(MEMORY_JSON)

# ================= PARSER UNIVERSAL =================
def parse_file(fname: str, data: bytes) -> Tuple[str, Optional[str], Optional[str]]:
    """Retorna (texto_extraido, image_b64, mime)"""
    ext=Path(fname).suffix.lower()
    if ext in IMAGE_EXTS:
        mime=mimetypes.guess_type(fname)[0] or "image/jpeg"
        b64=base64.b64encode(data).decode()
        return f"[Imagem {fname} - serÃ¡ analisada por visÃ£o]\n", b64, mime
    elif ext in {".txt",".md",".csv",".json",".py",".js",".ts",".html",".css",".sh",".java",".c",".cpp",".rs",".go",".yaml",".yml",".ini",".log"}:
        try: txt=data.decode(errors='ignore')
        except: txt=""
        return txt[:20000], None, None
    elif ext == ".pdf":
        tmp=Path(tempfile.gettempdir())/f"dida_{hashlib.md5(fname.encode()).hexdigest()}.pdf"
        tmp.write_bytes(data)
        txt=""
        try:
            out=subprocess.run(["pdftotext",str(tmp),"-"],capture_output=True,timeout=8)
            if out.returncode==0:
                txt=out.stdout.decode(errors='ignore')
        except: pass
        if not txt or len(txt.strip())<50:
            try:
                import fitz
                doc=fitz.open(str(tmp))
                txt="\n".join([p.get_text() for p in doc])
                # se ainda pouco texto, Ã© PDF escaneado -> vai pra visÃ£o OCR depois
                if len(txt.strip())<50:
                    # pega primeira pÃ¡gina como imagem pra OCR via visÃ£o
                    try:
                        page=doc[0]
                        pix=page.get_pixmap(dpi=150)
                        img_data=pix.tobytes("png")
                        b64=base64.b64encode(img_data).decode()
                        return f"[PDF escaneado {fname} - primeira pÃ¡gina enviada pra OCR]\n", b64, "image/png"
                    except: pass
            except: pass
        return txt[:20000], None, None
    elif ext in {".docx"}:
        try:
            import docx
            tmp=Path(tempfile.gettempdir())/f"dida_{hashlib.md5(fname.encode()).hexdigest()}{ext}"
            tmp.write_bytes(data)
            doc=docx.Document(str(tmp))
            txt="\n".join([p.text for p in doc.paragraphs])
            return txt[:20000], None, None
        except Exception as e:
            return f"[DOCX {fname} erro: {e}]", None, None
    elif ext in {".xlsx",".xls"}:
        try:
            import pandas as pd
            tmp=Path(tempfile.gettempdir())/f"dida_{hashlib.md5(fname.encode()).hexdigest()}{ext}"
            tmp.write_bytes(data)
            df=pd.read_excel(str(tmp))
            return f"[Planilha {fname} {df.shape[0]} linhas x {df.shape[1]} colunas]\n{df.head(20).to_string()}\n", None, None
        except Exception as e:
            return f"[XLSX {fname} erro: {e}]", None, None
    else:
        return f"[Arquivo {fname} {len(data)} bytes - tipo nÃ£o parseado, apenas nome]", None, None

# ================= FALA =================
def speech_text(texto: str) -> str:
    """Tira marcas de formataÃ§Ã£o que a voz leria literalmente."""
    texto=re.sub(r"\[([^\]]+)\]\((?:https?://)?[^)]+\)",r"\1",texto)
    texto=re.sub(r"https?://\S+", "", texto)
    texto=re.sub(r"(?m)^\s*(?:[-*â€¢]|\d+[.)])\s+", "", texto)
    texto=re.sub(r"[*_`#~]+", "", texto)
    return re.sub(r"\s+", " ", texto).strip()

class Fala:
    def __init__(self):
        self.fila=queue.Queue()
        self.parada=threading.Event()
        self.ocupada=threading.Event()
        self._busy_lock=threading.Lock()
        self.level=0.0
        self.disponivel=False
        try:
            import pygame
            pygame.mixer.init(frequency=24000,size=-16,channels=1,buffer=512)
            self.disponivel=True
        except Exception as e:
            print(f"[Fala] mixer {e}")

    def falar(self, texto:str):
        texto=speech_text(texto)
        if texto.strip() and self.disponivel:
            with self._busy_lock:
                self.ocupada.set()
                self.fila.put(texto)

    def _clear_if_idle(self):
        with self._busy_lock:
            if self.fila.empty():
                self.ocupada.clear()
                # DÃ¡ tempo para o Ã¡udio residual do alto-falante desaparecer do monitor.
                if "estado" in globals(): estado.tts_tail_until=time.time()+1.2

    def parar(self):
        while not self.fila.empty():
            try: self.fila.get_nowait()
            except: break
        self.parada.set()
        try:
            import pygame
            pygame.mixer.stop()
            pygame.mixer.music.stop()
        except: pass
        self.level=0.0
        self._clear_if_idle()

    def start(self):
        if not self.disponivel:
            print("[TTS] Ã¡udio desativado; respostas continuam disponÃ­veis na interface")
            return
        def loop():
            try:
                import pygame
            except Exception as e:
                print(f"[TTS] pygame indisponÃ­vel: {e}")
                return
            import asyncio
            try: import edge_tts
            except: edge_tts=None
            while True:
                try: texto=self.fila.get(timeout=0.2)
                except queue.Empty: continue
                if not texto.strip(): continue
                self.parada.clear()
                tmp=f"/tmp/dida_{hashlib.md5(texto.encode()).hexdigest()[:8]}.mp3"
                try:
                    gerado=False
                    if edge_tts:
                        try:
                            async def gen():
                                com=edge_tts.Communicate(texto, voice=VOICE, rate=RATE)
                                await com.save(tmp)
                            asyncio.run(gen())
                            gerado=Path(tmp).exists() and Path(tmp).stat().st_size>0
                        except Exception as e:
                            print(f"[TTS edge_tts] {e}; tentando pyttsx3")
                    if not gerado:
                        import pyttsx3
                        eng=pyttsx3.init(); eng.setProperty('rate',160)
                        eng.save_to_file(texto,tmp); eng.runAndWait()
                except Exception as e:
                    print(f"[TTS] {e}"); self._clear_if_idle(); continue
                try:
                    if self.parada.is_set(): self._clear_if_idle(); continue
                    pygame.mixer.music.load(tmp)
                    pygame.mixer.music.play()
                    while pygame.mixer.music.get_busy():
                        if self.parada.is_set():
                            pygame.mixer.music.stop(); break
                        self.level=0.5+0.5*abs(math.sin(time.time()*9))
                        time.sleep(0.05)
                    self.level=0.0
                except Exception as e:
                    print(f"[play] {e}")
                finally:
                    try: Path(tmp).unlink(missing_ok=True)
                    except Exception: pass
                    self._clear_if_idle()
        threading.Thread(target=loop,daemon=True).start()

