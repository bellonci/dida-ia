.user{align-self:flex-end;background:var(--user)}
.sys{align-self:center;background:transparent;color:var(--muted);font-size:12px}
.composer{position:fixed;z-index:6;left:50%;bottom:0;transform:translateX(-50%);width:min(800px,100%);background:rgba(15,15,15,.94);background:color-mix(in srgb,var(--bg) 94%,transparent);backdrop-filter:blur(14px);padding:10px 16px calc(10px + env(safe-area-inset-bottom));display:flex;gap:8px;align-items:flex-end;border-top:1px solid #222}
.composer textarea{flex:1;background:var(--panel);color:var(--text);border:1px solid #2a2a2a;border-radius:12px;padding:10px 12px;resize:none;min-height:44px;max-height:140px}
.composer button{border:0;border-radius:10px;padding:10px 14px;cursor:pointer}
#send{background:var(--accent);color:white}
#attach{background:#2a2a2a;color:var(--text)}
.chip{display:inline-flex;align-items:center;gap:6px;background:#252525;border:1px solid #333;border-radius:999px;padding:4px 10px;font-size:12px}
.chip img{width:28px;height:28px;border-radius:6px;object-fit:cover}
#mem{font-size:11px;color:var(--muted);text-align:center;padding:4px}
.profile-dialog{width:min(540px,calc(100vw - 28px));border:1px solid #444;border-radius:18px;padding:22px;background:#1b1b1f;color:var(--text);box-shadow:0 22px 70px #000b}
.profile-dialog::backdrop{background:#000a;backdrop-filter:blur(5px)}
.profile-dialog h2{margin:0 0 6px;font-size:20px}.profile-dialog p{margin:0 0 16px;color:var(--muted)}
.profile-dialog label{display:block;margin:12px 0 5px;font-size:13px}.profile-dialog input,.profile-dialog textarea{width:100%;border:1px solid #454545;border-radius:10px;background:#111;color:var(--text);padding:10px;font:inherit}.profile-dialog textarea{min-height:150px;resize:vertical}
.profile-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:16px}.profile-actions button{border:0;border-radius:10px;padding:9px 13px;cursor:pointer}.profile-actions #profileSave{background:var(--accent);color:white}
@media (max-width:600px){:root{--orb-size:min(360px,82vw);--dock-bottom:clamp(112px,14dvh,145px)}.ball-wrap{opacity:.94}.controls{gap:7px;font-size:11px}#chat{padding-bottom:190px}.composer{padding-left:10px;padding-right:10px}}
@media (prefers-reduced-motion:reduce){#ball{filter:saturate(.8)}}
</style></head><body>
<div class="wrap"><div class="ball-wrap"><canvas id="ball" width="720" height="720"></canvas><div class="controls"><label>Sens <span id="sensVal"></span></label><input id="sens" type="range" min="0" max="1" step="0.05"><span id="status"></span><span id="route" style="background:#222;padding:2px 8px;border-radius:999px"></span><button id="profileOpen" type="button">Sobre mim</button></div><div id="mem"></div></div><div id="chat"></div><div id="chips"></div><div class="composer"><button id="attach">ðŸ“Ž</button><input id="file" type="file" hidden accept=".txt,.md,.pdf,.png,.jpg,.jpeg,.webp,.docx,.xlsx,.csv,.json"><textarea id="input" placeholder="Fale, digite ou anexe um arquivo..."></textarea><button id="send">Enviar</button></div></div>
<dialog id="profileDialog" class="profile-dialog" aria-labelledby="profileTitle"><h2 id="profileTitle">Vamos nos conhecer?</h2><p>Cole o que a Dida deve saber sobre vocÃª. O perfil fica neste computador e Ã© enviado Ã  Groq nas respostas. Um tema de interesse pode ser consultado na Tavily para a curiosidade do dia.</p><label for="profileName">Seu nome</label><input id="profileName" maxlength="80" autocomplete="name"><label for="profileInterests">Interesses e hobbies</label><input id="profileInterests" maxlength="500" placeholder="Ex.: mÃºsica, astronomia, futebol"><label for="profileAbout">Mais sobre vocÃª</label><textarea id="profileAbout" maxlength="4000" placeholder="Cole aqui suas preferÃªncias e informaÃ§Ãµes que queira compartilhar com a Dida."></textarea><div class="profile-actions"><button id="profileLater" type="button">Agora nÃ£o</button><button id="profileSave" type="button">Salvar</button></div></dialog>
<script>
const chat=document.getElementById('chat'),input=document.getElementById('input'),send=document.getElementById('send'),attachBtn=document.getElementById('attach'),fileInput=document.getElementById('file'),chipsDiv=document.getElementById('chips'),statusEl=document.getElementById('status'),sens=document.getElementById('sens'),sensVal=document.getElementById('sensVal'),routeEl=document.getElementById('route'),memEl=document.getElementById('mem');
const profileDialog=document.getElementById('profileDialog'),profileOpen=document.getElementById('profileOpen'),profileName=document.getElementById('profileName'),profileInterests=document.getElementById('profileInterests'),profileAbout=document.getElementById('profileAbout'),profileSave=document.getElementById('profileSave'),profileLater=document.getElementById('profileLater');
let attached=null,levels={user:0,bot:0},speaking={user:false,bot:false},liveBot=null;
function addBubble(t,who,imgUrl=null){const d=document.createElement('div');d.className='bubble '+who; d.textContent=t; if(imgUrl){const im=document.createElement('img'); im.src=imgUrl; d.appendChild(im);} chat.appendChild(d); chat.scrollTop=chat.scrollHeight;}
function startBot(){liveBot=document.createElement('div'); liveBot.className='bubble bot'; liveBot.textContent=''; chat.appendChild(liveBot); chat.scrollTop=chat.scrollHeight;}
function appendBot(t){if(!liveBot) startBot(); liveBot.textContent+=t; chat.scrollTop=chat.scrollHeight;}
function setStatus(t){statusEl.textContent=t;}
fetch('/api/sens').then(r=>r.json()).then(j=>{sens.value=j.v; sensVal.textContent=j.v;});
fetch('/api/mem').then(r=>r.json()).then(j=>{memEl.textContent=j.count+' conversas salvas';});
fetch('/api/profile').then(r=>r.json()).then(j=>{addBubble(j.greeting,'bot');profileName.value=j.name||'';profileInterests.value=j.interests||'';profileAbout.value=j.about||'';if(!j.intro_seen)setTimeout(()=>{if(!profileDialog.open)profileDialog.showModal();},500);});
profileOpen.onclick=()=>{if(!profileDialog.open)profileDialog.showModal();};
profileLater.onclick=()=>profileDialog.close();
profileDialog.addEventListener('close',()=>fetch('/api/profile',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({intro_seen:true})}).catch(()=>{}));
profileSave.onclick=async()=>{try{const r=await fetch('/api/profile',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:profileName.value,interests:profileInterests.value,about:profileAbout.value,intro_seen:true})});if(!r.ok)throw new Error();profileDialog.close();setStatus('InformaÃ§Ãµes sobre vocÃª salvas.');}catch{setStatus('NÃ£o consegui salvar suas informaÃ§Ãµes.');}};
sens.addEventListener('input',()=>{sensVal.textContent=sens.value; fetch('/api/sens',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({v:parseFloat(sens.value)})});});
attachBtn.onclick=()=>fileInput.click();
fileInput.onchange=()=>{const f=fileInput.files[0]; if(!f) return; if(f.size>20*1024*1024){alert('Arquivo >20MB'); return;} attached=f; const isImg=f.type.startsWith('image/'); if(isImg){const url=URL.createObjectURL(f); chipsDiv.innerHTML=`<span class="chip"><img src="${url}">${f.name} <button onclick="clearChip()">âœ•</button></span>`;} else {chipsDiv.innerHTML=`<span class="chip">${f.name} <button onclick="clearChip()">âœ•</button></span>`;}};
window.clearChip=()=>{attached=null; chipsDiv.innerHTML=''; fileInput.value='';};
async function doSend(){let text=input.value.trim(); if(!text&&!attached) return; let imgUrl=null; if(attached&&attached.type.startsWith('image/')) imgUrl=URL.createObjectURL(attached); const hadFile=!!attached; if(hadFile){const fd=new FormData(); fd.append('file',attached); fd.append('texto',text); addBubble((text?text+'\n':'')+`[anexo: ${attached.name}]`,'user',imgUrl); input.value=''; clearChip(); try{const res=await fetch('/anexo',{method:'POST',body:fd}); if(!res.ok) throw new Error(`HTTP ${res.status}`); const j=await res.json(); if(j.route) routeEl.textContent=j.route;}catch(e){addBubble('NÃ£o consegui enviar o anexo. Confira se a Dida continua aberta.','sys');}} else {addBubble(text,'user'); input.value=''; try{const res=await fetch('/api/msg',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({texto:text})}); if(!res.ok) throw new Error(`HTTP ${res.status}`); const j=await res.json(); if(j.route) routeEl.textContent=j.route;}catch(e){addBubble('NÃ£o consegui enviar a mensagem. Confira se a Dida continua aberta.','sys');}}}
send.onclick=doSend; input.addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault(); doSend();}});
const canvas=document.getElementById('ball'),ctx=canvas.getContext('2d'); let angle=0,lastDraw=0;
const reduceMotion=window.matchMedia('(prefers-reduced-motion: reduce)');
function drawBall(now=0){if(now-lastDraw<(reduceMotion.matches?250:33)){requestAnimationFrame(drawBall);return;}lastDraw=now;const t=now/1000,w=canvas.width,h=canvas.height,cx=w/2,cy=h/2;ctx.clearRect(0,0,w,h);const level=Math.max(levels.user,levels.bot),active=speaking.user||speaking.bot;const pulse=reduceMotion.matches?0:(active?(level*22+Math.sin(t*2.2)*6):(level*8+Math.sin(t*1.2)*3));const base=245+pulse;const hue=reduceMotion.matches?272:(t*28+(speaking.user?182:272))%360;angle+=(reduceMotion.matches?0.002:(active?0.035:0.012));ctx.beginPath();for(let i=0;i<128;i++){const a=i/128*2*Math.PI;const r=base+Math.sin(a*3+angle)*pulse+Math.sin(a*5-angle*.45)*(active?12:6);const x=cx+r*Math.cos(a),y=cy+r*Math.sin(a);if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y);}ctx.closePath();const grad=ctx.createRadialGradient(cx-base*.25,cy-base*.3,base*.08,cx,cy,base*1.25);grad.addColorStop(0,`hsla(${hue},100%,88%,.96)`);grad.addColorStop(.38,`hsla(${(hue+70)%360},100%,64%,.9)`);grad.addColorStop(.72,`hsla(${(hue+150)%360},100%,52%,.62)`);grad.addColorStop(1,`hsla(${(hue+230)%360},100%,42%,.18)`);ctx.fillStyle=grad;ctx.shadowColor=`hsla(${(hue+35)%360},100%,62%,.8)`;ctx.shadowBlur=42+level*30;ctx.fill();ctx.shadowBlur=0;requestAnimationFrame(drawBall);}drawBall();
const ev=new EventSource('/api/events'); ev.onmessage=e=>{try{const d=JSON.parse(e.data); if(d.type==='level'){levels=d.levels; speaking=d.speaking;} else if(d.type==='bot_start'){liveBot=null; startBot();} else if(d.type==='bot_delta'){appendBot(d.text);} else if(d.type==='bot'){if(liveBot){liveBot.textContent=d.text;} else {addBubble(d.text,'bot');} liveBot=null;} else if(d.type==='user'){addBubble(d.text,'user');} else if(d.type==='status'){setStatus(d.text);} else if(d.type==='sys'){addBubble(d.text,'sys');} else if(d.type==='stopped'){setStatus('Parei'); setTimeout(()=>setStatus(''),1200);}}catch{}}; ev.onerror=()=>setStatus('Reconectandoâ€¦');
</script></body></html>
"""

from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

class Handler(BaseHTTPRequestHandler):
    def log_message(self,*a): pass
    def do_GET(self):
        if self.path in ("/","/index.html"):
            self.send_response(200); self.send_header("Content-Type","text/html; charset=utf-8"); self.end_headers()
            self.wfile.write(HTML_PAGE.encode())
        elif self.path.startswith("/api/events"):
            self.send_response(200)
            self.send_header("Content-Type","text/event-stream")
            self.send_header("Cache-Control","no-cache")
            self.send_header("Connection","keep-alive")
            self.end_headers()
            with estado.lock: estado.clients.append(self)
            try:
                while True:
                    time.sleep(0.066)
                    payload={"type":"level","levels":{"user":estado.level_user,"bot":max(estado.level_dida,estado.fala.level)},"speaking":{"user":estado.speaking_user,"bot":estado.speaking_dida or estado.fala.ocupada.is_set()}}
                    try:
                        with estado.lock:
                            self.wfile.write(f"data: {json.dumps(payload)}\n\n".encode())
                            self.wfile.flush()
                    except: break
            finally:
                with estado.lock:
                    if self in estado.clients: estado.clients.remove(self)
        elif self.path.startswith("/api/sens"):
            self.send_response(200); self.send_header("Content-Type","application/json"); self.end_headers()
            self.wfile.write(json.dumps({"v":estado.sensibilidade}).encode())
        elif self.path.startswith("/api/mem"):
            self.send_response(200); self.send_header("Content-Type","application/json"); self.end_headers()
            self.wfile.write(json.dumps({"count": len(memory.data["conversas"])}).encode())
        elif self.path.startswith("/api/profile"):
            personal=profile_snapshot()
            self.send_response(200); self.send_header("Content-Type","application/json; charset=utf-8"); self.end_headers()
            self.wfile.write(json.dumps({**personal,"greeting":f"Oi, {personal['name']}. Estou pronta para conversar."},ensure_ascii=False).encode())
        else:
            self.send_response(404); self.end_headers()

    def do_POST(self):
        length=int(self.headers.get("Content-Length","0"))
        if self.path=="/api/profile":
            try:
                if length>8192: raise ValueError("Perfil muito longo")
                body=json.loads(self.rfile.read(length).decode("utf-8"))
                if not isinstance(body,dict): raise ValueError("Perfil invÃ¡lido")
                current=profile_snapshot()
                save_profile(str(body.get("name",current["name"])),
                             str(body.get("about",current["about"])),
                             str(body.get("interests",current["interests"])),
                             bool(body.get("intro_seen",current["intro_seen"])))
                if "interests" in body and str(body["interests"]).strip():
                    threading.Thread(target=share_daily_curiosity,daemon=True).start()
                self.send_response(200); self.send_header("Content-Type","application/json; charset=utf-8"); self.end_headers()
                self.wfile.write(json.dumps({"ok":True},ensure_ascii=False).encode())
            except Exception as e:
                try:
                    self.send_response(400); self.end_headers(); self.wfile.write(str(e).encode())
                except BrokenPipeError: pass
            return
        if self.path=="/api/sens":
            body=self.rfile.read(length).decode()
            try:
                v=float(json.loads(body).get("v",0.5)); v=max(0.0,min(1.0,v))
                estado.sensibilidade=v; save_sens(v)
                try:
                    self.send_response(200); self.send_header("Content-Type","application/json"); self.end_headers()
                    self.wfile.write(b'{"ok":true}')
                except BrokenPipeError:
                    pass
            except Exception as e:
                try:
                    self.send_response(400); self.end_headers(); self.wfile.write(str(e).encode())
                except: pass
            return
        if self.path=="/api/msg":
            body=self.rfile.read(length).decode()
            try:
                j=json.loads(body); txt=j.get("texto","").strip()
                route=classify_query(txt, False) if txt else "fast"
                if txt:
                    submit_message(txt)
                try:
                    self.send_response(200); self.send_header("Content-Type","application/json"); self.end_headers()
                    self.wfile.write(json.dumps({"ok":True,"route":route}).encode())
                except BrokenPipeError:
                    pass
            except Exception as e:
                try:
                    self.send_response(500); self.end_headers(); self.wfile.write(str(e).encode())
                except: pass
            return
        if self.path=="/anexo":
            ctype=self.headers.get("Content-Type","")
            try:
                body=self.rfile.read(length)
                envelope=(f"Content-Type: {ctype}\r\nMIME-Version: 1.0\r\n\r\n".encode()+body)
                form=BytesParser(policy=policy.default).parsebytes(envelope)
                if not form.is_multipart(): raise ValueError("Formato de anexo invÃ¡lido")
                fitem=None; texto=""
                for part in form.iter_parts():
                    field=part.get_param("name",header="content-disposition")
                    value=part.get_payload(decode=True) or b""
                    if field=="texto": texto=value.decode(part.get_content_charset() or "utf-8",errors="replace")
                    elif field=="file" and part.get_filename():
                        fitem=(part.get_filename(),value)
                image_b64=None; mime=None; parsed_txt=""; route="fast"
                if fitem is not None:
                    fname,data=fitem
                    if len(data)>MAX_FILE: raise ValueError("Arquivo >20MB")
                    parsed_txt, image_b64, mime = parse_file(fname, data)
                    route=classify_query(texto+" "+parsed_txt, image_b64 is not None)
                full=(texto+"\n"+parsed_txt).strip()
                if image_b64:
                    submit_message(full,image_b64,mime)
                elif full:
                    submit_message(full)
                try:
                    self.send_response(200); self.send_header("Content-Type","application/json"); self.end_headers()
                    self.wfile.write(json.dumps({"ok":True,"route":route}).encode())
                except BrokenPipeError:
                    pass
            except Exception as e:
                import traceback; traceback.print_exc()
                try:
                    self.send_response(500); self.end_headers(); self.wfile.write(str(e).encode())
                except: pass
            return
        self.send_response(404); self.end_headers()

def process_msg(msg:str):
    try:
        estado.speaking_dida=True
        broadcast({"type":"status","text":"Processando sua mensagem..."})
        contexto=""
        # Busca online para perguntas atuais ou quando o usuÃ¡rio pede pesquisa.
        if needs_web_search(msg):
            # Tavily primeiro; DuckDuckGo se nÃ£o houver resultado.
            if TAVILY_API_KEY:
                try:
                    broadcast({"type":"status","text":"Pesquisando informaÃ§Ãµes atuais..."})
                    import requests
                    r=requests.post("https://api.tavily.com/search", json={"api_key": TAVILY_API_KEY, "query": msg, "search_depth":"basic", "include_answer": True, "max_results":5}, timeout=8)
                    if r.ok:
                        j=r.json()
                        if j.get("answer"): contexto+=j["answer"]+"\n"
                        for res in j.get("results",[])[:3]:
                            contexto+=res.get("content","")[:400]+"\n"
                        print(f"[Tavily] OK {len(contexto)} chars")
                    else:
                        print(f"[Tavily HTTP {r.status_code}] {r.text[:300]}")
                except Exception as e:
                    print(f"[Tavily] {e}")
            # 2. Fallback DuckDuckGo se Tavily nÃ£o trouxe nada
            if not contexto:
                try:
                    import requests
                    r=requests.get("https://duckduckgo.com/html/", params={"q":msg}, timeout=4, headers={"User-Agent":"Mozilla/5.0"})
                    if r.ok:
                        snippets=re.findall(r'class="result__snippet"[^>]*>(.*?)</a>', r.text)[:3]
                        contexto="\n".join(re.sub(r"<.*?>","",s) for s in snippets)
                except: pass
        full_resp=""; frases_buf=""; ui_buf=""; ui_last=time.time()
        broadcast({"type":"bot_start"})
        for token in call_llm_stream(msg, contexto):
            if estado.interrupt_flag.is_set(): break
            full_resp+=token; frases_buf+=token; ui_buf+=token
            if ui_buf and (time.time()-ui_last>=0.12 or any(p in ui_buf for p in [".","!","?","\n"])):
                broadcast({"type":"bot_delta","text":ui_buf}); ui_buf=""; ui_last=time.time()
            if any(p in frases_buf for p in [".","!","?","\n"]) and len(frases_buf)>20:
                m=re.search(r'(.+?[.!?])\s+', frases_buf)
                if m:
                    fr=m.group(1); frases_buf=frases_buf[len(fr):]
                    estado.fala.falar(fr)
        if frases_buf.strip() and not estado.interrupt_flag.is_set():
            estado.fala.falar(frases_buf.strip())
        if ui_buf and not estado.interrupt_flag.is_set(): broadcast({"type":"bot_delta","text":ui_buf})
        estado.speaking_dida=False; estado.level_dida=0.0; estado.last_bot=full_resp
        if full_resp.strip():
            broadcast({"type":"bot","text":full_resp})
            if not estado.interrupt_flag.is_set(): memory.add(msg, full_resp)
        time.sleep(TAIL_MS/1000.0)
    except Exception as e:
        import traceback; traceback.print_exc()
        broadcast({"type":"sys","text":f"Erro: {e}"}); estado.speaking_dida=False

def process_msg_vision(msg:str, image_b64:str, mime:str):
    try:
        estado.speaking_dida=True
        broadcast({"type":"status","text":"Analisando a imagem..."})
        full_resp=""; frases_buf=""; ui_buf=""; ui_last=time.time()
        broadcast({"type":"bot_start"})
        for token in call_llm_stream(msg, "", has_image=True, image_b64=image_b64, mime=mime):
            if estado.interrupt_flag.is_set(): break
            full_resp+=token; frases_buf+=token; ui_buf+=token
            if ui_buf and (time.time()-ui_last>=0.12 or any(p in ui_buf for p in [".","!","?","\n"])):
                broadcast({"type":"bot_delta","text":ui_buf}); ui_buf=""; ui_last=time.time()
            if any(p in frases_buf for p in [".","!","?","\n"]) and len(frases_buf)>20:
                m=re.search(r'(.+?[.!?])\s+', frases_buf)
                if m:
                    fr=m.group(1); frases_buf=frases_buf[len(fr):]
                    estado.fala.falar(fr)
        if frases_buf.strip() and not estado.interrupt_flag.is_set():
            estado.fala.falar(frases_buf.strip())
        if ui_buf and not estado.interrupt_flag.is_set(): broadcast({"type":"bot_delta","text":ui_buf})
        estado.speaking_dida=False; estado.level_dida=0.0; estado.last_bot=full_resp
        if full_resp.strip():
            broadcast({"type":"bot","text":full_resp})
            if not estado.interrupt_flag.is_set(): memory.add(msg+f" [imagem {mime}]", full_resp, {"vision":True})
        time.sleep(TAIL_MS/1000.0)
    except Exception as e:
        import traceback; traceback.print_exc()
        broadcast({"type":"sys","text":f"Erro visÃ£o: {e}"}); estado.speaking_dida=False

def prepare_stt_audio(audio_data: np.ndarray) -> np.ndarray:
    """Padroniza volume e duraÃ§Ã£o para frases curtas nÃ£o chegarem fracas ao STT."""
    audio=np.asarray(audio_data,dtype=np.float32).reshape(-1)
    audio=np.nan_to_num(audio,nan=0.0,posinf=0.0,neginf=0.0)
    if len(audio)==0: return audio
    # O Whisper entende melhor uma pequena margem de silÃªncio ao redor da fala.
    pad=int(SAMPLE_RATE*0.10)
    audio=np.pad(audio,(pad,pad))
    level=rms(audio)
    peak=float(np.max(np.abs(audio))) if len(audio) else 0.0
    if 1e-4<level<0.055 and peak>0.003:
        audio=np.clip(audio*min(3.0,0.075/(level+1e-9)),-1.0,1.0)
    return audio.astype(np.float32)

def transcribe_groq_whisper(audio_data: np.ndarray) -> Optional[str]:
    """Tenta Groq Whisper Large v3 (melhor), depois local, depois Google"""
    audio_data=prepare_stt_audio(audio_data)
    # 1) Groq Whisper
    if GROQ_API_KEY:
        tmp=None
        try:
            import requests
            tmp=Path(tempfile.gettempdir())/f"dida_whisper_{int(time.time()*1000)}.wav"
            import soundfile as sf
            sf.write(str(tmp), audio_data, SAMPLE_RATE)
            with open(tmp, 'rb') as f:
                files={'file': (tmp.name, f, 'audio/wav')}
                data={'model': GROQ_WHISPER_MODEL, 'language':'pt', 'response_format':'json',
                      'temperature':'0',
                      'prompt':f'Dida Ã© o nome da assistente. {profile_snapshot()["name"]} Ã© o nome do usuÃ¡rio. Fala em portuguÃªs do Brasil.'}
                r=requests.post("https://api.groq.com/openai/v1/audio/transcriptions",
                    headers={"Authorization":f"Bearer {GROQ_API_KEY}"},
                    files=files, data=data, timeout=25)
                if r.status_code==200:
                    j=r.json()
                    txt=j.get("text","").strip()
                    if txt:
                        return txt
                else:
                    print(f"[Groq Whisper HTTP {r.status_code}] {r.text[:400]}")
        except Exception as e:
            print(f"[Groq Whisper] {e}")
        finally:
            if tmp is not None:
                try: tmp.unlink(missing_ok=True)
                except Exception: pass

    # 2) faster-whisper local
    try:
        from faster_whisper import WhisperModel
        if estado.__dict__.get("whisper_model") is None:
            estado.whisper_model=WhisperModel("tiny", device="cpu", compute_type="int8")
        segments, _ = estado.whisper_model.transcribe(audio_data, language="pt", beam_size=3, vad_filter=True)
        txt=" ".join([s.text for s in segments]).strip()
        if txt:
            return txt
    except Exception as e:
        print(f"[local whisper] {e}")

    # 3) Google
    try:
        import speech_recognition as sr
        rec=sr.Recognizer()
        audio_bytes=(audio_data*32767).astype(np.int16).tobytes()
        audio=sr.AudioData(audio_bytes, SAMPLE_RATE, 2)
        txt=rec.recognize_google(audio, language="pt-BR")
        return txt
    except Exception as e:
        print(f"[Google STT] {e}")
    return None

def mic_thread():
    try:
        import sounddevice as sd
    except Exception as e:
        print(f"[mic] sounddevice faltando: {e}"); return
    try:
        devs=sd.query_devices()
        mic_idx=None; mon_idx=None
        preferred=os.environ.get("DIDA_MIC_DEVICE", "").strip()
        if preferred:
            for i,d in enumerate(devs):
                if ((preferred.isdigit() and i==int(preferred)) or
                    (not preferred.isdigit() and preferred.lower() in d['name'].lower())) and d['max_input_channels']>0:
                    mic_idx=i; break
        if mic_idx is None:
            try:
                default_mic=int(sd.default.device[0])
                if (default_mic>=0 and
                    devs[default_mic]['max_input_channels']>0 and
                    'monitor' not in devs[default_mic]['name'].lower()):
                    mic_idx=default_mic
            except Exception:
                pass
        if mic_idx is None:
            for i,d in enumerate(devs):
                if d['max_input_channels']>=1 and 'monitor' not in d['name']:
                    mic_idx=i; break
        for i,d in enumerate(devs):
            n=d['name']
            if 'analog-stereo.monitor' in n:
                mon_idx=i
        if mon_idx is None:
            for i,d in enumerate(devs):
                if 'monitor' in d['name']:
                    mon_idx=i; break
    except Exception as e:
        print(f"[mic] query erro {e}"); mic_idx=None; mon_idx=None

    try:
        mic_name=devs[mic_idx]['name'] if mic_idx is not None else 'indisponÃ­vel'
        mon_name=devs[mon_idx]['name'] if mon_idx is not None else 'desativado'
    except Exception:
        mic_name=str(mic_idx); mon_name=str(mon_idx)
    print(f"[mic v5] mic={mic_idx} ({mic_name}) monitor={mon_idx} ({mon_name}) WhisperGroq={'ON' if GROQ_API_KEY else 'OFF'}")
    q_mic=queue.Queue(maxsize=100); q_mon=queue.Queue(maxsize=100)
    def mic_cb(indata, frames, time_, status):
        try: q_mic.put_nowait(AudioBlock(ts=time.time(), data=indata[:,0].copy() if indata.ndim>1 else indata.copy()))
        except queue.Full: pass
    def mon_cb(indata, frames, time_, status):
        try: q_mon.put_nowait(AudioBlock(ts=time.time(), data=indata[:,0].copy() if indata.ndim>1 else indata.copy()))
        except queue.Full: pass

    try:
        mic_stream=sd.InputStream(device=mic_idx, channels=1, samplerate=SAMPLE_RATE, blocksize=BLOCK, callback=mic_cb)
        mic_stream.start()
        mon_stream=None
        if mon_idx is not None:
            mon_stream=sd.InputStream(device=mon_idx, channels=1, samplerate=SAMPLE_RATE, blocksize=BLOCK, callback=mon_cb)
            mon_stream.start()
        estado.mic_ready.set()
    except Exception as e:
        print(f"[mic] falha streams: {e}"); return

    buf_len=SAMPLE_RATE*3
    buf_mic=np.zeros(buf_len, dtype=np.float32)
    buf_ref=np.zeros(buf_len, dtype=np.float32)
    pos=0
    barge_hold=0
    barge_recording=False
    barge_chunks=[]
    barge_silence=0
    env_samples=[]
    try:
        from faster_whisper import WhisperModel
        estado.whisper_model=WhisperModel("tiny", device="cpu", compute_type="int8")
        print("[mic] faster-whisper tiny OK")
    except Exception as e:
        print(f"[mic] whisper fallback Groq ({e})")
    last_delay_update=0
    speech_active=False
    speech_silence=0
    speech_chunks=[]
    idle_preroll=[]
    # webrtcvad opcional
    vad=None
    try:
        import webrtcvad
        vad=webrtcvad.Vad(2)
        print("[mic] webrtcvad ON")
    except: pass

    while True:
        try:
            mic_block: AudioBlock = q_mic.get(timeout=0.5)
            mon_block_data=np.zeros_like(mic_block.data)
            temp_mon=[]
            while not q_mon.empty():
                try: temp_mon.append(q_mon.get_nowait())
                except: break
            if temp_mon:
                closest=min(temp_mon, key=lambda x: abs(x.ts - mic_block.ts))
                if abs(closest.ts - mic_block.ts) < 0.08:
                    mon_block_data=closest.data
                for mb in temp_mon[-5:]:
                    if mb is not closest:
                        q_mon.put(mb)
            else:
                try:
                    mb=q_mon.get(timeout=0.02)
                    mon_block_data=mb.data
                except:
                    mon_block_data=np.zeros_like(mic_block.data)

            n=len(mic_block.data)
            if pos+n > buf_len:
                buf_mic=np.roll(buf_mic, -n); buf_ref=np.roll(buf_ref, -n); pos=buf_len-n
            buf_mic[pos:pos+n]=mic_block.data; buf_ref[pos:pos+n]=mon_block_data; pos+=n
            mic_e=rms(mic_block.data); mon_e=rms(mon_block_data)
            voice_threshold=max(0.012,estado.ambiente*(3.4-2.4*estado.sensibilidade))
            user_voice=mic_e>=voice_threshold
            # O monitor Ã© o Ã¡udio da prÃ³pria Dida. NÃ£o trate vazamento baixo como voz do usuÃ¡rio.
            # SÃ³ trate como eco quando o microfone estiver claramente abaixo do
            # monitor. Voz do usuÃ¡rio pode ser mais baixa que a Dida.
            echo_only=mon_e>0.03 and mic_e < max(0.025, mon_e*0.42)
            if echo_only: user_voice=False
            vad_voice=True
            if vad and len(mic_block.data)==BLOCK and user_voice:
                try:
                    vad_voice=vad.is_speech((mic_block.data*32767).astype(np.int16).tobytes(), SAMPLE_RATE)
                except Exception:
                    vad_voice=True
            voice_active=user_voice and vad_voice
            estado.level_user=min(1.0, mic_e*14); estado.speaking_user=voice_active
            if not estado.speaking_dida and mic_e<0.05:
                env_samples.append(mic_e)
                if len(env_samples)>120:
                    env_samples=env_samples[-120:]; estado.ambiente=float(np.median(env_samples))
            if mon_e>0.05 and mic_e<0.18 and not estado.speaking_user:
                new_bleed = mic_e/(mon_e+1e-10)
                if 0.05 < new_bleed < 0.7:
                    estado.bleed = 0.98*estado.bleed + 0.02*new_bleed
                    estado.bleed = max(0.05, min(0.6, estado.bleed))
            if time.time()-last_delay_update>1.0 and mon_e>0.02:
                corr, d = norm_xcorr(buf_mic[max(0,pos-8000):pos], buf_ref[max(0,pos-8000):pos])
                if corr>0.5:
                    estado.delay_est = int(0.9*estado.delay_est + 0.1*d)
                last_delay_update=time.time()
            if barge_recording:
                barge_chunks.append(mic_block.data.copy())
                barge_silence=0 if voice_active else barge_silence+1
                if barge_silence>=55 or len(barge_chunks)>=1250:
                    tail=max(0,barge_silence-4)
                    usable=barge_chunks[:-tail] if tail else barge_chunks
                    audio=np.concatenate(usable) if usable else np.array([],dtype=np.float32)
                    barge_recording=False; barge_chunks=[]; barge_silence=0
                    if len(audio)>=int(SAMPLE_RATE*0.35):
                        queue_transcription(audio,is_barge=True)
                    else:
                        estado.barge_pending.clear()
            elif (estado.speaking_dida or estado.fala.ocupada.is_set()) and not estado.barge_pending.is_set():
                speech_active=False; speech_silence=0; speech_chunks=[]; idle_preroll=[]
                # Barge-in precisa reagir ao quadro atual. A versÃ£o anterior
                # analisava uma janela de 1,5 s e depois exigia outra validaÃ§Ã£o
                # no Ãºltimo quadro; isso fazia a fala curta passar despercebida.
                is_user=voice_active
                if is_user and mon_e>0.03:
                    residual=max(0.0,mic_e-estado.bleed*mon_e)
                    # O usuÃ¡rio pode falar por cima de uma resposta mais alta;
                    # basta sobrar voz acima do ruÃ­do ou superar levemente o
                    # nÃ­vel do monitor, sem a razÃ£o rÃ­gida de 1,15 anterior.
                    if residual<max(0.008,estado.ambiente*2.0) and mic_e<mon_e*1.02:
                        is_user=False
                if is_user: barge_hold+=1
                else: barge_hold=max(0, barge_hold-1)
                if barge_hold>=BARGE_BLOCKS:
                    print(f"[BARGE v5] bleed={estado.bleed:.2f}")
                    estado.barge_pending.set()
                    estado.fala.parar(); estado.interrupt_flag.set(); broadcast({"type":"stopped"}); barge_hold=0
                    start=max(0,pos-int(SAMPLE_RATE*0.55))
                    stt_win=buf_mic[start:pos]
                    ref_win=buf_ref[start:pos]
                    if len(ref_win)==len(stt_win) and mon_e>0.02:
                        stt_win=np.clip(stt_win-estado.bleed*ref_win,-1.0,1.0)
                    barge_recording=True
                    barge_chunks=[stt_win.copy()]
                    barge_silence=0
                    broadcast({"type":"status","text":"Estou ouvindo sua interrupÃ§Ã£o..."})
            elif not estado.speaking_dida and not estado.fala.ocupada.is_set() and not estado.barge_pending.is_set() and time.time()>=estado.tts_tail_until:
                if not speech_active:
                    idle_preroll.append(mic_block.data.copy())
                    idle_preroll=idle_preroll[-15:]
                    if voice_active:
                        speech_active=True
                        speech_chunks=idle_preroll.copy()
                        speech_silence=0
                else:
                    speech_chunks.append(mic_block.data.copy())
                    if voice_active:
                        speech_silence=0
                    else:
                        speech_silence+=1
                    # Pausas naturais nÃ£o devem cortar uma frase no meio.
                    # Fecha apÃ³s 1,3 s de silÃªncio ou 25 s contÃ­nuos de fala.
                    if speech_silence>=65 or len(speech_chunks)>=1250:
                        tail=max(0,speech_silence-4)
                        usable=speech_chunks[:-tail] if tail else speech_chunks
                        audio=np.concatenate(usable) if usable else np.array([],dtype=np.float32)
                        speech_active=False; speech_silence=0; speech_chunks=[]; idle_preroll=[]
                        if len(audio)>=int(SAMPLE_RATE*0.35):
                            queue_transcription(audio,is_barge=False)
        except queue.Empty:
            continue
        except Exception as e:
            import traceback; traceback.print_exc(); time.sleep(0.1)

def open_ui(port: int, app_window: bool = False):
    """Abre a interface em uma janela sem abas quando um Chromium estÃ¡ disponÃ­vel."""
    url = f"http://127.0.0.1:{port}"
    if app_window:
        candidates = [
            "google-chrome", "google-chrome-stable", "chromium", "chromium-browser",
            "microsoft-edge", "brave-browser"
        ]
        for browser in candidates:
            if shutil.which(browser):
                try:
                    subprocess.Popen([browser, f"--app={url}", "--new-window", "--start-maximized"],
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    print(f"[Dida] janela prÃ³pria aberta com {browser}")
                    return
                except OSError:
                    pass
        print("[Dida] nenhum navegador compatÃ­vel com janela prÃ³pria; usando navegador padrÃ£o")
    try:
        subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as e:
        print(f"[Dida] nÃ£o consegui abrir a interface: {e}")

def main():
    parser=argparse.ArgumentParser()
    parser.add_argument("--autoteste", action="store_true")
    parser.add_argument("--janela", action="store_true", help="abre a Dida em janela prÃ³pria, sem abas e barra de endereÃ§o")
    parser.add_argument("--navegador", action="store_true", help="forÃ§a a abertura como aba normal do navegador")
    args=parser.parse_args()
    if args.autoteste:
        autoteste(); return
    port=8765
    try:
        httpd=ThreadingHTTPServer(("127.0.0.1", port), Handler)
    except OSError:
        print("[Dida] Outra instÃ¢ncia jÃ¡ estÃ¡ aberta. Feche a Dida anterior antes de iniciar a V5.")
        return
    httpd.daemon_threads=True
    threading.Thread(target=response_worker,daemon=True).start()
    threading.Thread(target=transcription_worker,daemon=True).start()
    print(f"[Dida 5.0 Ultimate] UI http://127.0.0.1:{port} | Mem={len(memory.data['conversas'])} | WhisperGroq={'ON' if GROQ_API_KEY else 'OFF'} | Reserva={OLLAMA_MODEL}")
    # A janela prÃ³pria Ã© o padrÃ£o; --navegador mantÃ©m o modo antigo para diagnÃ³stico.
    threading.Thread(target=open_ui, args=(port, not args.navegador), daemon=True).start()
    threading.Thread(target=mic_thread, daemon=True).start()
    def greet_once():
        estado.mic_ready.wait(timeout=8)
        time.sleep(1)
        if not (estado.speaking_user or estado.speaking_dida or estado.fala.ocupada.is_set() or not request_queue.empty()):
            estado.fala.falar(f"Oi, {profile_snapshot()['name']}. Estou pronta para conversar.")
        if profile_snapshot()["interests"]:
            threading.Thread(target=share_daily_curiosity,daemon=True).start()
    threading.Thread(target=greet_once, daemon=True).start()
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass

if __name__=="__main__":
    main()
